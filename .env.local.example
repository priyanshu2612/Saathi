# Copy this file to .env.local and fill in real values once your Supabase
# project exists. Until these are set, the app runs fully on mock data
# (see src/lib/data/*) so you can click through every screen without a backend.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" to force mock-data mode even when the vars above are set.
NEXT_PUBLIC_DEMO_MODE=true
