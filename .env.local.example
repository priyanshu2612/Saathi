# Copy this file to .env.local and fill in real values once your Supabase
# project exists. Until these are set, the app runs fully on mock data
# (see src/lib/data/*) so you can click through every screen without a backend.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" to make new seekers verify their phone with an SMS code (MSG91).
# Also set the Supabase function secrets MSG91_AUTH_KEY, MSG91_TEMPLATE_ID and
# OTP_REQUIRED=true, and deploy the `phone_otp` function, before turning this on.
NEXT_PUBLIC_OTP_ENABLED=

# Set to "true" to force mock-data mode even when the vars above are set.
NEXT_PUBLIC_DEMO_MODE=true

# ── Owner admin dashboard (/admin) ─────────────────────────────────────────
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Set these in Vercel too.
# Supabase -> Project Settings -> API -> "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=
# The one password that unlocks /admin. Use a long random one (20+ chars).
# Changing it signs you out everywhere.
ADMIN_PASSWORD=
# Optional extra secret mixed into the session-cookie signature.
ADMIN_SESSION_SECRET=
